@model AdminMatchListViewModel
@{ ViewData["Title"] = "Quản lý cáp kèo"; Layout = "_AdminLayout"; }
<section class="admin-page shell"><div class="admin-heading"><div><span class="kicker">CỘNG ĐỒNG</span><h1>Quản lý cáp kèo</h1><p>Theo dõi chủ kèo, người tham gia và trạng thái đặt cọc.</p></div></div>
@if (TempData["AdminError"] is string error) { <div class="admin-error">@error</div> }
<div class="admin-match-list">@foreach (var match in Model.Matches) { <article class="admin-match-card"><header><div><span class="kicker">@match.MatchCode · @match.Status</span><h2>@match.SportName tại @match.VenueName</h2><p>@match.MatchDate.ToString("dd/MM/yyyy") · @match.StartTime · Chủ kèo @match.HostName · @match.PhoneNumber</p></div><div><strong>@match.ConfirmedCount</strong><span>đã cọc / @match.RequestCount yêu cầu</span></div></header>
<div class="admin-request-list">@if (match.Requests.Count == 0) { <p>Chưa có yêu cầu tham gia.</p> } @foreach (var request in match.Requests) { <div><span><strong>@request.ApplicantName</strong><small>@request.PhoneNumber · @request.RequestCode</small></span><span class="admin-badge">@request.Status</span><strong>@request.DepositAmount.ToString("N0")đ</strong>@if(request.Status == "Chờ thanh toán") { <form asp-action="UpdateMatchRequest" method="post"><input type="hidden" name="requestCode" value="@request.RequestCode" /><input type="hidden" name="status" value="Đã xác nhận" /><button class="confirm-button">Xác nhận cọc</button></form> }</div> }</div>
@if(match.Status == "Đang tuyển") { <form class="close-match-form" asp-action="CloseMatch" method="post"><input type="hidden" name="matchCode" value="@match.MatchCode" /><button class="cancel-button">Đóng kèo</button></form> }</article> }</div></section>
