@model AdminVenueFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Chỉnh sửa sân" : "Thêm sân mới";
    Layout = "_AdminLayout";
}

<section class="admin-page shell admin-form-page">
    <div class="admin-heading"><div><span class="kicker">QUẢN LÝ SÂN</span><h1>@(isEdit ? "Chỉnh sửa thông tin sân" : "Tạo cụm sân mới")</h1><p>Cập nhật thông tin hiển thị, giá và ảnh đại diện.</p></div><a class="admin-text-link" asp-action="Venues">← Quay lại danh sách</a></div>
    <form class="venue-form" asp-action="@(isEdit ? "EditVenue" : "CreateVenue")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" /><input asp-for="ExistingImagePath" type="hidden" />
        <div asp-validation-summary="All" class="validation-summary"></div>
        <section class="form-panel"><div class="form-panel-title"><span>01</span><div><h2>Thông tin chung</h2><p>Thông tin khách nhìn thấy khi tìm sân.</p></div></div><div class="admin-form-grid"><label class="wide" asp-for="Name"><span>Tên cụm sân</span><input asp-for="Name" /><small asp-validation-for="Name"></small></label><label asp-for="District"><span>Quận/Huyện</span><input asp-for="District" /></label><label asp-for="PhoneNumber"><span>Số điện thoại</span><input asp-for="PhoneNumber" /></label><label class="wide" asp-for="Address"><span>Địa chỉ</span><input asp-for="Address" /></label><label asp-for="OpenTime"><span>Giờ mở cửa</span><input asp-for="OpenTime" type="time" /></label><label asp-for="CloseTime"><span>Giờ đóng cửa</span><input asp-for="CloseTime" type="time" /></label><label class="wide" asp-for="Amenities"><span>Tiện ích, ngăn cách bằng dấu ;</span><textarea asp-for="Amenities" rows="3"></textarea></label><label class="wide" asp-for="Description"><span>Mô tả</span><textarea asp-for="Description" rows="4"></textarea></label></div></section>
        <section class="form-panel"><div class="form-panel-title"><span>02</span><div><h2>Sân con và bảng giá</h2><p>Cấu hình sân đầu tiên của cụm sân.</p></div></div><div class="admin-form-grid"><label asp-for="CourtName"><span>Tên sân con</span><input asp-for="CourtName" /></label><label asp-for="SportName"><span>Môn thể thao</span><select asp-for="SportName"><option>Bóng đá mini</option><option>Cầu lông</option><option>Pickleball</option><option>Bóng rổ</option><option>Tennis</option><option>Bóng chuyền</option></select></label><label asp-for="CourtType"><span>Loại sân</span><input asp-for="CourtType" /></label><label asp-for="OffPeakPrice"><span>Giá giờ thường</span><input asp-for="OffPeakPrice" type="number" step="1000" /></label><label asp-for="PeakPrice"><span>Giá giờ vàng</span><input asp-for="PeakPrice" type="number" step="1000" /></label></div></section>
        <section class="form-panel"><div class="form-panel-title"><span>03</span><div><h2>Hình ảnh sân</h2><p>JPG, PNG hoặc WebP, tối đa 5 MB.</p></div></div><div class="image-upload-row">@if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath)) { <img src="@Model.ExistingImagePath" alt="Ảnh sân hiện tại" /> }<label class="image-upload" asp-for="Image"><span>Chọn ảnh từ máy</span><input asp-for="Image" type="file" accept="image/jpeg,image/png,image/webp" /><small asp-validation-for="Image"></small></label></div></section>
        <div class="admin-form-actions"><a asp-action="Venues">Hủy</a><button class="primary-button" type="submit">@(isEdit ? "Lưu thay đổi" : "Tạo sân")</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
