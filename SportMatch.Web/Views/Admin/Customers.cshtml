@model IReadOnlyList<AdminCustomerViewModel>
@{ ViewData["Title"] = "Khách hàng & liên hệ"; Layout = "_AdminLayout"; }
<section class="admin-page shell"><div class="admin-heading"><div><span class="kicker">DỮ LIỆU LIÊN HỆ</span><h1>Khách hàng &amp; liên hệ</h1><p>Không cần tài khoản — dữ liệu được tổng hợp từ số điện thoại khách đã để lại.</p></div></div>
<div class="admin-board admin-table-wrap"><table><thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Đặt sân</th><th>Chủ kèo</th><th>Tham gia kèo</th><th>Hoạt động gần nhất</th></tr></thead><tbody>@foreach(var customer in Model) { <tr><td><strong>@customer.Name</strong></td><td><a href="tel:@customer.PhoneNumber">@customer.PhoneNumber</a><br /><small>@customer.Email</small></td><td>@customer.BookingCount</td><td>@customer.HostedMatchCount</td><td>@customer.JoinRequestCount</td><td>@customer.LastActivity.ToString("dd/MM/yyyy HH:mm")</td></tr> }</tbody></table>@if(Model.Count == 0) { <div class="admin-empty">Chưa có khách hàng để hiển thị.</div> }</div></section>
