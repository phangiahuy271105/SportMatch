@model AdminOperationsViewModel
@{ ViewData["Title"] = "Nhật ký vận hành"; Layout = "_AdminLayout"; }
<section class="admin-page shell"><div class="admin-heading"><div><span class="kicker">KIỂM SOÁT HỆ THỐNG</span><h1>Nhật ký vận hành</h1><p>100 sự kiện mới nhất của thanh toán và thao tác quản trị.</p></div></div>
<div class="operations-grid"><section class="admin-board"><div class="admin-board-heading"><h2>Webhook thanh toán</h2><span>@Model.PaymentLogs.Count sự kiện</span></div><div class="admin-table-wrap"><table><thead><tr><th>Thời gian</th><th>Mã giao dịch</th><th>Nội dung</th><th>Số tiền</th><th>Kết quả</th></tr></thead><tbody>@foreach(var log in Model.PaymentLogs) { <tr><td>@log.ReceivedAt.ToString("dd/MM HH:mm:ss")</td><td>@log.TransactionId</td><td>@log.Content</td><td>@log.Amount.ToString("N0")đ</td><td><span class="admin-badge">@log.Result</span></td></tr> }</tbody></table></div></section>
<section class="admin-board"><div class="admin-board-heading"><h2>Thao tác Admin</h2><span>@Model.AuditLogs.Count sự kiện</span></div><div class="admin-table-wrap"><table><thead><tr><th>Thời gian</th><th>Admin</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead><tbody>@foreach(var log in Model.AuditLogs) { <tr><td>@log.OccurredAt.ToString("dd/MM HH:mm:ss")</td><td>@log.AdminName</td><td>@log.Action</td><td>@log.EntityType · @log.EntityId</td><td>@log.Details</td></tr> }</tbody></table></div></section></div></section>
@section Styles { <link rel="stylesheet" href="~/css/admin-operations.css" asp-append-version="true" /> }
