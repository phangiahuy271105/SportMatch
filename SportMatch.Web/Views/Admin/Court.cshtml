@model AdminCourtViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = Model.Id == 0 ? "Thêm sân con" : "Chỉnh sửa sân con"; }
<section class="admin-page shell"><div class="admin-heading"><h1>@ViewData["Title"]</h1><a asp-action="Courts" asp-route-id="@Model.VenueComplexId">← Quay lại</a></div>
<form class="venue-form" method="post" enctype="multipart/form-data"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="VenueComplexId" /><input type="hidden" asp-for="ExistingImagePath" /><input type="hidden" asp-for="HasOwnImage" /><div asp-validation-summary="All" class="validation-summary"></div><section class="form-panel"><div class="admin-form-grid">
<label><span>Tên sân</span><input asp-for="Name" /></label><label><span>Môn</span><select asp-for="SportName">@foreach(var sport in new[] {"Bóng đá mini","Cầu lông","Pickleball","Bóng rổ","Tennis","Bóng chuyền"}) { <option>@sport</option> }</select></label>
<label><span>Loại sân</span><input asp-for="CourtType" /></label><label><span>Giá giờ thường</span><input asp-for="OffPeakPrice" type="number" /></label><label><span>Giá giờ vàng</span><input asp-for="PeakPrice" type="number" /></label><label><span><input asp-for="IsActive" /> Hiển thị sân này cho khách</span></label>
</div></section>
<section class="form-panel"><div class="form-panel-title"><span>ẢNH</span><div><h2>Ảnh riêng của sân con</h2><p>Nếu chưa tải ảnh riêng, trang khách sẽ dùng ảnh đại diện của cụm sân.</p></div></div><div class="image-upload-row">@if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath)) { <img src="@Model.ExistingImagePath" alt="Ảnh sân hiện tại" /> }<label class="image-upload" asp-for="Image"><span>Chọn ảnh riêng từ máy</span><input asp-for="Image" type="file" accept="image/jpeg,image/png,image/webp" /><small asp-validation-for="Image"></small>@if (Model.HasOwnImage) { <span class="remove-image-option"><input asp-for="RemoveImage" /> Xóa ảnh riêng và dùng lại ảnh cụm sân</span> }</label></div></section>
@if (Model.Slots.Count > 0) { <section class="form-panel"><div class="form-panel-title"><h2>Khung giờ mở đặt — bỏ chọn để tạm khóa</h2></div><div class="admin-form-grid">@foreach(var slot in Model.Slots) { <label><span><input type="checkbox" name="ActiveSlots" value="@slot.Id" checked="@Model.ActiveSlots.Contains(slot.Id)" /> @slot.Time</span></label> }</div></section> }
<div class="admin-form-actions"><button class="primary-button" type="submit">Lưu sân con</button></div></form></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
