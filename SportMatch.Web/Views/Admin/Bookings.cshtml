@model AdminDashboardViewModel
@{ ViewData["Title"] = "Quản lý đặt sân"; Layout = "_AdminLayout"; }
<section class="admin-page shell">
    <div class="admin-heading"><div><span class="kicker">VẬN HÀNH</span><h1>Đặt sân, hủy &amp; hoàn cọc</h1><p>Tra cứu khách, xác nhận thanh toán và xử lý yêu cầu hủy theo chính sách.</p></div></div>
    <form class="admin-filter" method="get"><input name="search" value="@ViewData["Search"]" placeholder="Tìm mã đặt, tên khách, số điện thoại…" aria-label="Tìm booking" /><select name="status" aria-label="Trạng thái"><option value="">Mọi trạng thái</option>@foreach(var status in new[] { "Chờ thanh toán", "Đã xác nhận", "Yêu cầu hủy", "Đã hủy", "Hết hạn" }) { <option selected="@(ViewData["Status"] as string == status)" value="@status">@status</option> }</select><button class="primary-button">Lọc danh sách</button></form>
    @if (TempData["AdminError"] is string error) { <p class="admin-error">@error</p> }
    <div class="admin-booking-list">
    @if(Model.Bookings.Count == 0) { <div class="admin-empty">Không có booking phù hợp.</div> }
    @foreach(var booking in Model.Bookings) {
        <article class="admin-booking-card">
            <header><div><span class="kicker">@booking.BookingCode</span><h2>@booking.VenueName · @booking.CourtName</h2><p>@booking.BookingDate.ToString("dd/MM/yyyy") · @booking.StartTime · @booking.SlotCount giờ</p></div><span class="admin-badge">@booking.Status</span></header>
            <div class="admin-booking-info"><span>Khách<strong>@booking.CustomerName</strong><small>@booking.PhoneNumber · @booking.Email</small></span><span>Tiền cọc<strong>@booking.Deposit.ToString("N0")đ</strong><small>@(booking.RefundStatus ?? "Chưa hoàn")</small></span>@if(booking.RefundAmount > 0) { <span>Tiền hoàn<strong>@booking.RefundAmount.ToString("N0")đ</strong><small>@booking.RefundPercent%</small></span> }</div>
            @if(booking.Status == "Yêu cầu hủy") { <div class="cancellation-review"><div><strong>Khách yêu cầu hủy</strong><p>@booking.CancellationReason</p><span>Theo chính sách: hoàn @booking.RefundPercent% — @((booking.Deposit * (booking.RefundPercent ?? 0) / 100m).ToString("N0"))đ</span></div><div class="cancellation-actions"><form asp-action="ProcessCancellation" method="post"><input type="hidden" name="bookingCode" value="@booking.BookingCode" /><input type="hidden" name="decision" value="policy" /><button class="confirm-button">Duyệt theo chính sách</button></form><form asp-action="ProcessCancellation" method="post"><input type="hidden" name="bookingCode" value="@booking.BookingCode" /><input type="hidden" name="decision" value="full" /><button class="confirm-button">Hoàn 100% do sân</button></form><form asp-action="ProcessCancellation" method="post"><input type="hidden" name="bookingCode" value="@booking.BookingCode" /><input type="hidden" name="decision" value="reject" /><button class="cancel-button">Từ chối</button></form></div></div> }
            <footer class="admin-booking-actions">@if(booking.Status == "Chờ thanh toán") { <form asp-action="UpdateStatus" method="post"><input type="hidden" name="BookingCode" value="@booking.BookingCode" /><input type="hidden" name="Status" value="Đã xác nhận" /><button class="confirm-button">Xác nhận đã nhận cọc</button></form> }@if(booking.Status == "Đã xác nhận") { <form class="venue-cancel-form" asp-action="CancelByVenue" method="post"><input type="hidden" name="bookingCode" value="@booking.BookingCode" /><input name="reason" placeholder="Lý do sự cố sân/mưa bão" required /><button class="cancel-button">Hủy do sân · hoàn 100%</button></form> }@if(booking.RefundStatus == "Chờ hoàn tiền") { <form asp-action="MarkRefunded" method="post"><input type="hidden" name="bookingCode" value="@booking.BookingCode" /><button class="confirm-button">Đánh dấu đã hoàn @booking.RefundAmount.ToString("N0")đ</button></form> }</footer>
        </article>
    }
    </div>
</section>
@section Styles { <link rel="stylesheet" href="~/css/admin-bookings.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin-refunds.css" asp-append-version="true" /> }
